{
    "name":  "emp-saas-platform",
    "version":  "0.1.0",
    "private":  true,
    "scripts":  {
                    "dev:dashboard":  "cd apps/dashboard \u0026\u0026 vite",
                    "dev:extension":  "cd apps/extension \u0026\u0026 vite",
                    "build:dashboard":  "cd apps/dashboard \u0026\u0026 vite build",
                    "build:extension":  "cd apps/extension \u0026\u0026 vite build",
                    "check":  "tsc --noEmit",
                    "backend:verify":  "npm run check \u0026\u0026 node -e \"console.log(\u0027Backend verification passed\u0027)\"",
                    "dev":  "npm -w apps/dashboard run dev",
                    "build":  "npm -w apps/dashboard run build",
                    "start":  "npm -w apps/dashboard run start",
                    "typecheck":  "npm -w apps/dashboard run typecheck",
                    "dev:dashboard-v2":  "npm -w apps/dashboard-v2 run dev",
                    "build:dashboard-v2":  "npm -w apps/dashboard-v2 run build",
                    "start:dashboard-v2":  "npm -w apps/dashboard-v2 run start",
                    "typecheck:dashboard-v2":  "npm -w apps/dashboard-v2 run typecheck"
                },
    "workspaces":  [
                       "apps/*",
                       "packages/*"
                   ],
    "devDependencies":  {
                            "@vitejs/plugin-react":  "^5.1.4",
                            "typescript":  "^5.9.2",
                            "vite":  "^7.3.1"
                        },
    "dependencies":  {
                         "@supabase/supabase-js":  "^2.95.3",
                         "react":  "^19.2.4",
                         "react-dom":  "^19.2.4"
                     }
}
